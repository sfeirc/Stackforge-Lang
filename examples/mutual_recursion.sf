// Two functions calling each other. `is_even` calls `is_odd` before `is_odd`
// has been declared in the source -- this only works because the compiler
// registers every function's name+arity in a first pass before compiling
// any bodies (see compiler::compile).
fn is_even(n) {
    if (n == 0) {
        return true;
    }
    return is_odd(n - 1);
}

fn is_odd(n) {
    if (n == 0) {
        return false;
    }
    return is_even(n - 1);
}

print is_even(10);
print is_odd(10);
print is_even(7);
print is_odd(7);
